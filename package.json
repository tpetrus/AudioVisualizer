{
  "name": "audio-visualizer",
  "private": true,
  "type": "module",
  "version": "0.11.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc && tsc -p e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/smoke.mjs && node node_modules/.cache/smoke.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "e2e:fixture": "esbuild e2e/fixtures/generate-fixture.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/generate-fixture.mjs && node node_modules/.cache/generate-fixture.mjs",
    "eval:rhythm": "esbuild scripts/eval-rhythm.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/eval-rhythm.mjs && node node_modules/.cache/eval-rhythm.mjs",
    "ablate:rhythm": "esbuild scripts/rhythm-ablate.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/rhythm-ablate.mjs && node node_modules/.cache/rhythm-ablate.mjs",
    "sweep:onsets": "esbuild scripts/onset-sweep.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/onset-sweep.mjs && node node_modules/.cache/onset-sweep.mjs",
    "probe:rhythm": "esbuild scripts/rhythm-probe.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/rhythm-probe.mjs && node node_modules/.cache/rhythm-probe.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "size": "size-limit",
    "lighthouse": "lhci autorun",
    "title-banner": "esbuild scripts/title-banner/browser.ts --bundle --platform=browser --format=iife --log-level=warning --outfile=node_modules/.cache/title-banner-browser.js && esbuild scripts/title-banner/render.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/title-banner.mjs && node node_modules/.cache/title-banner.mjs",
    "images": "esbuild scripts/optimize-images.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/optimize-images.mjs && node node_modules/.cache/optimize-images.mjs",
    "replay:gate": "esbuild scripts/gate-replay.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/gate-replay.mjs && node node_modules/.cache/gate-replay.mjs",
    "debug:viz": "esbuild scripts/debug-visualizer/run.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/debug-viz.mjs && node node_modules/.cache/debug-viz.mjs",
    "debug:summary": "esbuild scripts/debug-visualizer/summarize.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/debug-summary.mjs && node node_modules/.cache/debug-summary.mjs",
    "debug:repeat": "esbuild scripts/debug-visualizer/repeat.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/debug-repeat.mjs && node node_modules/.cache/debug-repeat.mjs",
    "ground-truth": "esbuild scripts/ground-truth/generate.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/ground-truth.mjs && node node_modules/.cache/ground-truth.mjs",
    "tap:beats": "esbuild scripts/tap-along/run.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/tap-along.mjs && node node_modules/.cache/tap-along.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.8.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.4",
    "wrangler": "^4.152.0"
  }
}
