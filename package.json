{
  "name": "audio-visualizer",
  "private": true,
  "type": "module",
  "version": "0.1.0-beta",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:rhythm": "esbuild scripts/eval-rhythm.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/eval-rhythm.mjs && node node_modules/.cache/eval-rhythm.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "three": "^0.141.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.141.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
